# Facilitator wallet — signs and submits onchain txs (deposit/claim/settle/refund).
# Needs a small native-token balance for gas on every enabled network
# (ETH on Base/Base Sepolia/Arbitrum, BNB on BSC, POL on Polygon).
EVM_PRIVATE_KEY=0x...

# Networks to enable. Built-in registry with default public RPCs — no RPC
# configuration needed. Options:
#   all (default) | testnets | mainnets | comma-separated names:
#   base-sepolia, base, bsc-testnet, bsc, polygon, arbitrum
NETWORKS=all

# Optional per-chain RPC overrides (defaults are public endpoints):
# RPC_URL_BASE_SEPOLIA=
# RPC_URL_BASE=
# RPC_URL_BSC_TESTNET=
# RPC_URL_BSC=
# RPC_URL_POLYGON=
# RPC_URL_ARBITRUM=

# Optional dedicated authorizer key. When set, the facilitator advertises this
# address as receiverAuthorizer under /supported so servers can delegate to it.
# Leave empty to require servers to self-manage their authorizer (recommended).
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Settlement stats index (GET /stats). Live settles are indexed from receipts;
# history is backfilled from an explorer `txlist` for the facilitator address.
#   EXPLORER_API_KEY   — Etherscan V2 key (one key covers all built-in chains)
#   EXPLORER_URL_<NAME> — per-chain override, e.g. a keyless Blockscout:
#                        EXPLORER_URL_BASE_SEPOLIA=https://base-sepolia.blockscout.com/api
#   BACKFILL_INTERVAL  — re-scan cadence (default 10m)
#   STATS_FILE         — where totals + seen tx hashes persist (default data/stats.json)
EXPLORER_API_KEY=
BACKFILL_INTERVAL=10m

# USD totals in /stats (summary.totalUsd, per-asset priceUsd/valueUsd) via
# CoinMarketCap, resolved by contract address. Unset = no USD fields emitted.
#   CMC_API_KEY — https://pro.coinmarketcap.com (free Basic plan is enough)
#   PRICE_TTL   — quote cache (default 10m)
#   PRICE_PEG_USD — comma-separated token addresses valued at exactly $1.00,
#                   for USD-pegged tokens CMC does not list (e.g. XUSD on BSC).
#                   A peg overrides the market quote for that address.
CMC_API_KEY=
PRICE_PEG_USD=

# Listen port (default 4022).
PORT=4022
